<div
    data-ui-role="landing-page"
    data-ui-fragment="blocks.marketing.landing-page"
    {{ attributes }}
>
    <div data-ui-slot="header">{% block header %}{% endblock %}</div>
    <div data-ui-slot="banner">{% block banner %}{% endblock %}</div>
    <div data-ui-slot="hero">{% block hero %}{% endblock %}</div>
    <div data-ui-slot="logo_cloud">{% block logo_cloud %}{% endblock %}</div>
    <div data-ui-slot="stats">{% block stats %}{% endblock %}</div>
    <div data-ui-slot="features">{% block features %}{% endblock %}</div>
    <div data-ui-slot="content">{% block content %}{% endblock %}</div>
    <div data-ui-slot="pricing">{% block pricing %}{% endblock %}</div>
    <div data-ui-slot="testimonials">{% block testimonials %}{% endblock %}</div>
    <div data-ui-slot="faq">{% block faq %}{% endblock %}</div>
    <div data-ui-slot="team">{% block team %}{% endblock %}</div>
    <div data-ui-slot="newsletter">{% block newsletter %}{% endblock %}</div>
    <div data-ui-slot="cta">{% block cta %}{% endblock %}</div>
    <div data-ui-slot="footer">{% block footer %}{% endblock %}</div>
</div>