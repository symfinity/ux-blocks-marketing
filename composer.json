{
    "name": "symfinity/ux-blocks-marketing",
    "description": "Symfinity UX Blocks Marketing — nat marketing section catalog with blocks.marketing fragments",
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.2",
        "symfinity/ux-blocks-core": "@dev",
        "symfony/framework-bundle": "^7.4||^8.0",
        "symfony/twig-bundle": "^7.4||^8.0",
        "symfony/ux-twig-component": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfinity/ux-blocks": "@dev",
        "symfinity/ux-blocks-extended": "@dev",
        "symfony/browser-kit": "^7.4||^8.0",
        "symfony/css-selector": "^7.4||^8.0",
        "symfony/yaml": "^7.4||^8.0"
    },
    "suggest": {
        "symfinity/ux-blocks-extended": "Enhanced flyout dropdown (stl) for flyout-menu-marketing"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ux-blocks-core",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../ux-blocks-extended",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../ux-blocks",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "Symfinity\\UxBlocksMarketing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfinity\\UxBlocksMarketing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "0.1.0-dev",
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
